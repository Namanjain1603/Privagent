# M1 AI Agent Brain Configuration
# Port for M1 REST API service (Default: 3001 or 3000)
PORT=3001

# Gemini API Key for LLM planning
# Provide a valid Gemini API key from Google AI Studio
GEMINI_API_KEY=""

# Model to use (default: gemini-3.6-flash or gemini-2.0-flash)
GEMINI_MODEL="gemini-3.6-flash"

# Offline test/mock mode (true/false)
# When true, M1 uses heuristic reasoning fallback if GEMINI_API_KEY is not set
M1_ENABLE_MOCK_FALLBACK="false"
