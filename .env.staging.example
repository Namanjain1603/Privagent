# -------------------------------------------------------------------
# STAGING ENVIRONMENT CONFIGURATION - DO NOT COMMIT SECRETS
# -------------------------------------------------------------------

# 1. Your actual public domain (e.g. staging.privagent.com)
DOMAIN=YOUR_DOMAIN

# 2. Your Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 3. WebSocket URL for M3 Extension Staging Build (e.g. wss://staging.privagent.com/ws)
WS_URL=wss://YOUR_DOMAIN/ws

# Optional: Set Demo Mode to false in staging
DEMO_MODE=false
